<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project name="velka.types" basedir="." default="main">

    <property name="src.dir" value="src" />
    <property name="build.dir" value="." />
    <property name="classes.dir" value="${build.dir}/bin" />
    <property name="jar.dir" value="${build.dir}/jar" />
    
    <property name="jar.name" value="${jar.dir}/${ant.project.name}.jar" />

    <property name="velka.util.lib" value="../lib/velka.util.jar" />
    
    <path id="modulepath">
        <pathelement location="${velka.util.lib}" />
    </path>

    <target name="clean">
        <delete dir="${classes.dir}" />
        <delete dir="${jar.dir}" />
    </target>
    
    <target name="compile">
        <mkdir dir="${classes.dir}" />
        <javac srcdir="${src.dir}" destdir="${classes.dir}" modulepathref="modulepath" debug="false" />
    </target>
    
    <target name="jar" depends="compile">
        <mkdir dir="${jar.dir}" />
        <jar destfile="${jar.name}" basedir="${classes.dir}" />
    </target>

    <target name="main" depends="clean,jar" />
	
	<target name="compile-dbg">
        <mkdir dir="${classes.dir}" />
        <javac srcdir="${src.dir}" destdir="${classes.dir}" modulepathref="modulepath" debug="true"/>
    </target>
	
	<target name="jar-dbg" depends="compile-dbg">
        <mkdir dir="${jar.dir}" />
        <jar destfile="${jar.name}" basedir="${classes.dir}" />
    </target>
	
	<target name="dbg" depends="clean,jar-dbg" />
    
</project>
